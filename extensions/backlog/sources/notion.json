{
	"contract": 1,
	"id": "notion",
	"name": "Notion database",
	"link": {
		"prefix": "notion",
		"prefixes": ["notion"],
		"example": "notion:backlog/AB-84",
		"alias": "{id}"
	},
	"mode": "continuous",
	"trigger": ["webhook", "poll"],
	"fields": {
		"title": { "to": "title", "direction": "both", "clash": "both_changed" },
		"status": { "to": "status", "direction": "both", "clash": "both_changed" },
		"band": { "to": "band", "direction": "both", "clash": "both_changed" },
		"release": { "to": "release", "direction": "both", "clash": "both_changed" },
		"area": { "to": "area", "direction": "both", "clash": "both_changed" },
		"owner": { "to": "owner", "direction": "both", "clash": "both_changed" },
		"rank": { "to": "rank", "direction": "write", "clash": "flag" },
		"b_id": { "to": "id", "direction": "write", "clash": "flag" },
		"link": { "to": "url", "direction": "write", "clash": "flag" },
		"body": { "to": "detail", "direction": "read", "clash": "fill" }
	},
	"properties": {
		"title": ["Name", "Title"],
		"status": ["Status"],
		"band": ["Band"],
		"release": ["Release", "Version"],
		"area": ["Area"],
		"owner": ["Owner"],
		"issue": ["Issue", "Issues", "Issue / PR", "Issue/PR", "Forgejo", "GitHub", "Ticket"],
		"id": ["ID"],
		"rank": ["Rank"],
		"b_id": ["B ID"],
		"link": ["TomaTío"]
	},
	"statuses": {
		"idea": "inbox",
		"inbox": "inbox",
		"backlog": "inbox",
		"not started": "inbox",
		"todo": "ready",
		"to do": "ready",
		"planned": "ready",
		"next": "ready",
		"ready": "ready",
		"blocked": "ready",
		"in progress": "building",
		"building": "building",
		"doing": "building",
		"in review": "building",
		"done": "shipped",
		"shipped": "shipped",
		"released": "shipped",
		"won't do": "declined",
		"wont do": "declined",
		"declined": "declined",
		"dropped": "declined",
		"cancelled": "declined",
		"canceled": "declined",
		"parked": "parked",
		"on hold": "parked",
		"archived": "archived"
	},
	"bands": { "now": "now", "next": "next", "later": "later" },
	"adds_columns": ["Band", "Rank", "Release", "B ID", "TomaTío"],
	"adds_statuses": ["Archived"],
	"new_items": { "status": "inbox", "kind": "idea", "band_from": "band" },
	"echo": "Ignore an event whose author is the integration's own bot, or whose values match what was last written.",
	"credentials": [
		{ "name": "token", "what": "A Notion internal integration token with read and update rights on the one database, shared with the integration.", "required": true },
		{ "name": "database", "what": "The database ID (from its link).", "required": true }
	],
	"snapshot": ["status", "band", "release", "area", "owner", "last_edited_time"],
	"throttle": { "per_second": 3 }
}
