{
    "name": "agent-brain/plugin",
    "description": "TomaTío WordPress plugin skeleton",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "wordpress/mcp-adapter": "0.6.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "yoast/phpunit-polyfills": "^1.1",
        "wp-phpunit/wp-phpunit": "^7.1",
        "opis/json-schema": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "AgentBrain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentBrain\\Tests\\": "tests/",
            "AgentBrain\\Tests\\Integration\\": "tests/integration/",
            "AgentBrain\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "automattic/jetpack-autoloader": true
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
